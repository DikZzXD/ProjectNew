website\",\"name\":\"Rewind.ai\",\"url\":\"https://rewind.ai\",\"publisher\":{\"@id\":\"https://rewind.ai/#organization\"},\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://rewind.ai/tools/?q={search_term_string}\",\"query-input\":\"required name=search_term_string\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://rewind.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"App Directory\",\"item\":\"https://rewind.ai/apps/\"}]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is AI App Directory?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"AI App Directory on Rewind.ai is a free AI tool. There's no charge and no sign up needed to start.\"}},{\"@type\":\"Question\",\"name\":\"Is AI App Directory really free?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. You get 2,500 free tokens per day to use AI App Directory and every other tool on Rewind.ai. A free account raises that to 5,000 tokens/day. You can buy more starting at $1.\"}},{\"@type\":\"Question\",\"name\":\"How does AI App Directory work?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"AI App Directory runs open-source AI models on our GPU servers. Send your request and the result comes back in seconds.\"}},{\"@type\":\"Question\",\"name\":\"Do I need to sign up to use AI App Directory?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. You can use AI App Directory right away without signing up. A free account doubles your daily usage to 5,000 tokens and saves your history.\"}},{\"@type\":\"Question\",\"name\":\"What are the daily limits for AI App Directory?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Anonymous users get 2,500 tokens/day. Free accounts get 5,000 tokens/day. Tokens reset every 24 hours. Each generation costs ~100-5,000 tokens depending on the operation.\"}},{\"@type\":\"Question\",\"name\":\"Is my data safe when using AI App Directory?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Your data is processed on our servers and isn't stored permanently unless you choose to save it. We don't sell or share it.\"}},{\"@type\":\"Question\",\"name\":\"Can I use AI App Directory for commercial purposes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Content from AI App Directory is yours to use for personal or commercial work. The AI models we run are commercially licensed.\"}},{\"@type\":\"Question\",\"name\":\"How does AI App Directory compare to paid alternatives?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"AI App Directory matches the quality of paid services because it runs the latest open-source AI models. The difference is you don't pay per use.\"}},{\"@type\":\"Question\",\"name\":\"What AI model powers AI App Directory?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"AI App Directory runs open-source AI models including Qwen 2.5, FLUX and Whisper. We update to newer models as they ship.\"}},{\"@type\":\"Question\",\"name\":\"Can I use AI App Directory on my phone?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. AI App Directory works in any mobile browser, and the layout adapts to your screen size.\"}},{\"@type\":\"Question\",\"name\":\"How do I get more tokens?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sign up for a free account to get 5,000 tokens/day, double the anonymous limit. Or buy token packs starting at $5 for 200,000 tokens. See /pricing/ for all options.\"}},{\"@type\":\"Question\",\"name\":\"Can I save and share my results?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. After you generate content, you can download it, copy it, or share it via a unique link. Signed-in users can also view their generation history.\"}}]}]}0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"id\":\"jsonld-apps-graph\",\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],\"