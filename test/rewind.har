l\":\"support@rewind.ai\",\"description\":\"Rewind.ai offers 400+ free AI tools, chat, image generation, video, text-to-speech, music, writing, code and translation, powered by self-hosted open-source models.\",\"sameAs\":[\"https://rewind.ai/about/\",\"https://rewind.ai/contact/\"]},{\"@type\":\"WebSite\",\"@id\":\"https://rewind.ai/#website\",\"name\":\"Rewind.ai\",\"url\":\"https://rewind.ai\",\"publisher\":{\"@id\":\"https://rewind.ai/#organization\"},\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://rewind.ai/tools/?q={search_term_string}\",\"query-input\":\"required name=search_term_string\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://rewind.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Search\",\"item\":\"https://rewind.ai/search/\"}]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is AI Search?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"AI Search on Rewind.ai is a free AI tool. There's no charge and no sign up needed to start.\"}},{\"@type\":\"Question\",\"name\":\"Is AI Search really free?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. You get 2,500 free tokens per day to use AI Search and every other tool on Rewind.ai. A free account raises that to 5,000 tokens/day. You can buy more starting at $1.\"}},{\"@type\":\"Question\",\"name\":\"How does AI Search work?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"AI Search runs open-source AI models on our GPU servers. Send your request and the result comes back in seconds.\"}},{\"@type\":\"Question\",\"name\":\"Do I need to sign up to use AI Search?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. You can use AI Search right away without signing up. A free account doubles your daily usage to 5,000 tokens and saves your history.\"}},{\"@type\":\"Question\",\"name\":\"What are the daily limits for AI Search?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Anonymous users get 2,500 tokens/day. Free accounts get 5,000 tokens/day. Tokens reset every 24 hours. Each generation costs ~100-5,000 tokens depending on the operation.\"}},{\"@type\":\"Question\",\"name\":\"Is my data safe when using AI Search?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Your data is processed on our servers and isn't stored permanently unless you choose to save it. We don't sell or share it.\"}},{\"@type\":\"Question\",\"name\":\"Can I use AI Search for commercial purposes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Content from AI Search is yours to use for personal or commercial work. The AI models we run are commercially licensed.\"}},{\"@type\":\"Question\",\"name\":\"How does AI Search compare to paid alternatives?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"AI Search matches the quality of paid services because it runs the latest open-source AI models. The difference is you don't pay per use.\"}},{\"@type\":\"Question\",\"name\":\"What AI model powers AI Search?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"AI Search runs open-source AI models including Qwen 2.5, FLUX and Whisper. We update to newer models as they ship.\"}},{\"@type\":\"Question\",\"name\":\"Can I use AI Search on my phone?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. AI Search works in any mobile browser, and the layout adapts to your screen size.\"}},{\"@type\":\"Question\",\"name\":\"How do I get more tokens?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sign up for a free account to get 5,000 tokens/day, double the anonymous limit. Or buy token packs starting at $5 for 200,000 tokens. See /pricing/ for all options.\"}},{\"@type\":\"Question\",\"name\":\"Can I save and share my results?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. After you generate content, you can download it, copy it, or share it via a unique link. Signed-in users can also view their generation history.\"}}]}]}0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"id\":\"jsonld-search-1\",\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],\"$L3\",\"$L4\",\"$L5\"],[\"$L6\"],\"$L7\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"b1173g3rgHHnx1qRdOPx3\"}\n8:T41e,{\"@context\":\"https://schema.org\",\"@type\":\"SoftwareApplication\",\"name\":\"Free AI Search\",\"description\":\"Free AI search engine. Ask any question, get an AI-synthesized answer with cited sources from the live web. Private, no tracking, no account needed.\",\"url\":\"https://rewind.ai/search/\",\"applicationCategory\":\"UtilitiesApplication\",\"operatingSystem\":\"Web\",\"inLanguage\":\"en\",\"availableLanguage\":[\"af\",\"am\",\"ar\",\"az\",\"be\",\"bg\",\"bn\",\"bs\",\"ca\",\"cs\",\"cy\",\"da\",\"de\",\"el\",\"en\",\"es\",\"et\",\"eu\",\"fa\",\"fi\",\"fr\",\"ga\",\"gl\",\"gu\",\"ha\",\"he\",\"hi\",\"hr\",\"hu\",\"hy\",\"id\",\"ig\",\"is\",\"it\",\"ja\",\"ka\",\"kk\",\"km\",\"kn\",\"ko\",\"ku\",\"ky\",\"lo\",\"lt\",\"lv\",\"mk\",\"ml\",\"mn\",\"mr\",\"ms\",\"mt\",\"my\",\"ne\",\"nl\",\"no\",\"pa\",\"pl\",\"pt\",\"ro\",\"ru\",\"sd\",\"si\",\"sk\",\"sl\",\"sq\",\"sr\",\"sv\",\"sw\",\"ta\",\"te\",\"tg\",\"th\",\"tr\",\"uk\",\"ur\",\"uz\",\"vi\",\"yo\",\"zh\",\"zu\"],\"areaServed\":{\"@type\":\"Place\",\"name\":\"Worldwide\"},\"isAccessibleForFree\":true,\"availableOnDevice\":\"Web\",\"author\":{\"@id\":\"https://rewind.ai/#organization\"},\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\"}}3:[\"$\",\"script\",null,{\"id\":\"jsonld-search-2\",\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$8\"}}]\n4:[\"$\",\"$L9\",null,{}]\n5:[\"$\",\"div\",null,{\"className\":\"container py-5\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"fw-bold text-center mb-4\",\"style\":{\"fontSize\":\"1.3rem\"},\"children\":\"How AI Sear