/chunks/183wq3rz.xlq2.js\",\"/_next/static/chunks/0jzbfjzahbyd..js\",\"/_next/static/chunks/0leiwl~2t4b6-.js\",\"/_next/static/chunks/0xwy~c7hpj-j5.js\"],\"\"]\nb:I[578778,[\"/_next/static/chunks/183wq3rz.xlq2.js\",\"/_next/static/chunks/0jzbfjzahbyd..js\",\"/_next/static/chunks/0leiwl~2t4b6-.js\",\"/_next/static/chunks/0xwy~c7hpj-j5.js\"],\"UnifiedChat\"]\ne:I[693778,[\"/_next/static/chunks/04jo3~_f-qsew.js\"],\"OutletBoundary\"]\nf:\"$Sreact.suspense\"\n3:Tf28,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://rewind.ai/#organization\",\"name\":\"Rewind.ai\",\"url\":\"https://rewind.ai\",\"logo\":\"https://rewind.ai/img/icon-512.png\",\"email\":\"support@rewind.ai\",\"description\":\"Rewind.ai offers 400+ free AI tools, chat, image generation, video, text-to-speech, music, writing, code and translation, powered by self-hosted open-source models.\",\"sameAs\":[\"https://rewind.ai/about/\",\"https://rewind.ai/contact/\"]},{\"@type\":\"WebSite\",\"@id\":\"https://rewind.ai/#website\",\"name\":\"Rewind.ai\",\"url\":\"https://rewind.ai\",\"publisher\":{\"@id\":\"https://rewind.ai/#organization\"},\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://rewind.ai/tools/?q={search_term_string}\",\"query-input\":\"required name=search_term_string\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://rewind.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"AI Chat\",\"item\":\"https://rewind.ai/chat/\"}]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is AI Chat?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"AI Chat on Rewind.ai is a free AI tool. There's no charge and no sign up needed to start.\"}},{\"@type\":\"Question\",\"name\":\"Is AI Chat really free?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. You get 2,500 free tokens per day to use AI Chat and every other tool on Rewind.ai. A free account raises that to 5,000 tokens/day. You can buy more starting at $1.\"}},{\"@type\":\"Question\",\"name\":\"How does AI Chat work?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"AI Chat runs open-source AI models on our GPU servers. Send your request and the result comes back in seconds.\"}},{\"@type\":\"Question\",\"name\":\"Do I need to sign up to use AI Chat?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. You can use AI Chat right away without signing up. A free account doubles your daily usage to 5,000 tokens and saves your history.\"}},{\"@type\":\"Question\",\"name\":\"What are the daily limits for AI Chat?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Anonymous users get 2,500 tokens/day. Free accounts get 5,000 tokens/day. Tokens reset every 24 hours. Each generation costs ~100-5,000 tokens depending on the operation.\"}},{\"@type\":\"Question\",\"name\":\"Is my data safe when using AI Chat?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Your data is processed on our servers and isn't stored permanently unless you choose to save it. We don't sell or share it.\"}},{\"@type\":\"Question\",\"name\":\"Can I use AI Chat for commercial purposes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Content from AI Chat is yours to use for personal or commercial work. The AI models we run are commercially licensed.\"}},{\"@type\":\"Question\",\"name\":\"How does AI Chat compare to paid alternatives?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"AI Chat matches the quality of paid services because it runs the latest open-source AI models. The difference is you don't pay per use.\"}},{\"@type\":\"Question\",\"name\":\"What AI model powers AI Chat?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"AI Chat runs open-source AI models including Qwen 2.5, FLUX and Whisper. We update to newer models as they ship.\"}},{\"@type\":\"Question\",\"name\":\"Can I use AI Chat on my phone?\",\"acceptedAnswer\":{\"@ty