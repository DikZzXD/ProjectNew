ver","value":"cloudflare"},{"name":"cf-ray","value":"a2ef8e6fd9904679-HKG"}],"content":{"size":12281,"mimeType":"text/x-component","text":"1:\"$Sreact.fragment\"\n7:I[745006,[\"/_next/static/chunks/183wq3rz.xlq2.js\",\"/_next/static/chunks/0jzbfjzahbyd..js\",\"/_next/static/chunks/0xbh.hlsqq2il.js\"],\"ApiHero\"]\nb:I[693778,[\"/_next/static/chunks/04jo3~_f-qsew.js\"],\"OutletBoundary\"]\nc:\"$Sreact.suspense\"\n2:Tfa1,{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"Organization\",\"@id\":\"https://rewind.ai/#organization\",\"name\":\"Rewind.ai\",\"url\":\"https://rewind.ai\",\"logo\":\"https://rewind.ai/img/icon-512.png\",\"email\":\"support@rewind.ai\",\"description\":\"Rewind.ai offers 400+ free AI tools, chat, image generation, video, text-to-speech, music, writing, code and translation, powered by self-hosted open-source models.\",\"sameAs\":[\"https://rewind.ai/about/\",\"https://rewind.ai/contact/\"]},{\"@type\":\"WebSite\",\"@id\":\"https://rewind.ai/#website\",\"name\":\"Rewind.ai\",\"url\":\"https://rewind.ai\",\"publisher\":{\"@id\":\"https://rewind.ai/#organization\"},\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":\"https://rewind.ai/tools/?q={search_term_string}\",\"query-input\":\"required name=search_term_string\"}},{\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://rewind.ai/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"API\",\"item\":\"https://rewind.ai/api/\"}]},{\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is the Rewind API?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The Rewind API on Rewind.ai is a free AI tool. There's no charge and no sign up needed to start.\"}},{\"@type\":\"Question\",\"name\":\"Is the Rewind API really free?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. You get 2,500 free tokens per day to use the Rewind API and every other tool on Rewind.ai. A free account raises that to 5,000 tokens/day. You can buy more starting at $1.\"}},{\"@type\":\"Question\",\"name\":\"How does the Rewind API work?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The Rewind API runs open-source AI models on our GPU servers. Send your request and the result comes back in seconds.\"}},{\"@type\":\"Question\",\"name\":\"Do I need to sign up to use the Rewind API?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. You can use the Rewind API right away without signing up. A free account doubles your daily usage to 5,000 tokens and saves your history.\"}},{\"@type\":\"Question\",\"name\":\"What are the daily limits for the Rewind API?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Anonymous users get 2,500 tokens/day. Free accounts get 5,000 tokens/day. Tokens reset every 24 hours. Each generation costs ~100-5,000 tokens depending on the operation.\"}},{\"@type\":\"Question\",\"name\":\"Is my data safe when using the Rewind API?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Your data is processed on our servers and isn't stored permanently unless you choose to save it. We don't sell or share it.\"}},{\"@type\":\"Question\",\"name\":\"Can I use the Rewind API for commercial purposes?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Content from the Rewind API is yours to use for personal or commercial work. The AI models we run are commercially licensed.\"}},{\"@type\":\"Question\",\"name\":\"How does the Rewind API compare to paid alternatives?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The Rewind API matches the quality of paid services because it runs the latest open-source AI models. The difference is you don't pay per use.\"}},{\"@type\":\"Question\",\"name\":\"What AI model powers the Rewind API?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The Rewind API runs open-source AI models including Qwen 2.5, FLUX and Whisper. We update to newer models as they ship.\"}},{\"@type\":\"Question\",\"name\":\"Can I use the Rewind API on my phone?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. The Rewind API works in any mobile browser, and the layout adapts to your screen size.\"}},{\"@type\":\"Question\",\"name\":\"How do I get more tokens?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Sign up for a free account to get 5,000 tokens/day, double the anonymous limit. Or buy token packs starting at $5 for 200,000 tokens. See /pricing/ for all options.\"}},{\"@type\":\"Question\",\"name\":\"Can I save and share my results?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. After you generate content, you can download it, copy it, or share it via a unique link. Signed-in users can also view their generation history.\"}}]}]}0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"script\",null,{\"id\":\"jsonld-api-1\",\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$2\"}}],\"$L3\",\"$L4\"],[\"$L5\"],\"$L6\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"b1173g3rgHHnx1qRdOPx3\"}\n3:[\"$\",\"script\",null,{\"id\":\"jsonld-api-2\",\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"WebPage\\\",\\\"name\\\":\\\"Rewind.ai API - One Key for 400+ AI Tools\\\",\\\"description\\\":\\\"Token-based API covering chat, image generation, video, TTS, STT and more. OpenAI-compatible. Sign up free to get your key.\\\",\\\"url\\\":\\\"https://rewind.ai/api/\\\",\\\"isPartOf\\\":{\\\"@id\\\":\\\"https://rewind.ai/#website\\\"},\\\"provider\\\":{\\\"@id\\\":\\\"https://rewind.ai/#organization\\\"},\\\"inLanguage\\\":\\\"en\\\",\\\"areaServed\\\":{\\\"@type\\\":\\\"Place\\\",\\\"name\\\":\\\"Worldwide\\\"}}\"}}]\n8:T8f5,# Chat — text in, text out (free self-hosted Qwen3.5-9B; pass any model id from /v1/models)\ncurl -X POST https://api.rewind.ai/v1/chat/completions/ \\\n  -H \"Authorization: Bearer sk-rewind-YOUR_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"messages\": [{\"role\": \"user\", \"content\": \"Hello!\"}],\n    \"model\": \"qwen/qwen3.5-9b\"\n  }'\n\n# Generate an image (free FLUX.2 Klein 4B). Use any model id from /v1/models.\ncurl -X POST https://api.rewind.ai/v1/images/generations \\\n  -H \"Authorization: Bearer sk-rewind-YOUR_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"prompt\": \"A sunset over mountains\", \"model\": \"black-forest-labs/flux.2-klein-4b\", \"size\": \"1024x1024\"}'\n\n# Premium image (paid tokens). Full list at /v1/providers.\ncurl -X POST https://api.rewind.ai/v1/images/generations \\\n  -H \"Authorization: Bearer sk-rewind-YOUR_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"prompt\": \"A sunset over mountains\", \"model\": \"black-forest-labs/flux.2-pro\", \"size\": \"1024x1024\"}'\n\n# Generate a video, async (returns a job id; poll /v1/jobs/:id)\ncurl -X POST https://api.rewind.ai/v1/videos/generate-async \\\n  -H \"Authorization: Bearer sk-rewind-YOUR_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"prompt\": \"A cat running in slow motion\", \"duration\": \"5s\", \"aspectRatio\": \"16:9\", \"model\": \"bytedance/seedance-1-5-pro\"}'\n\n# Text to speech, model is fixed to Kokoro server-side; pass voice + speed\ncurl -X POST https://api.rewind.ai/v1/tts/ \\\n  -H \"Authorization: Bearer sk-rewind-YOUR_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\"text\": \"Hello world\", \"voice\": \"af_heart\", \"speed\": 1.0, \"format\": \"mp3\"}'\n\n# Speech to text, multipart upload (file required)\ncurl -X POST https://api.rewind.ai/v1/stt/ \\\n  -H \"Authorization: Bearer sk-rewind-YOUR_KEY\" \\\n  -F file=@recording.mp3 \\\n  -F language=auto\n\n# Translate, runs through /v1/chat/completions/ with a translate-style system prompt.\ncurl -X POST https://api.rewind.ai/v1/chat/completions/ \\\n  -H \"Authorization: Bearer sk-rewind-YOUR_KEY\" \\\n  -H \"Content-Type: application/json\" \\\n  -d '{\n    \"model\": \"qwen/qwen3.5-9b\",\n    \"messages\": [\n      {\"role\": \"system\", \"content\": \"Translate the user message to Spanish. Return only the translation.\"},\n      {\"role\": \"user\", \"content\": \"Hello world\"}\n    ]\n  }'4:[\"$\",\"div\",null,{\"className\":\"container py-5\",\"children\":[[\"$\",\"$L7\",null,{}],[\"$\",\"div\",null,{\"className\":\"row justify-content-center mb-5\",\"children\":[\"$\",\"div\",null,{\"className\":\"col-lg-10\",\"children\":[\"$\",\"div\",null,{\"className\":\"card border-0 shadow-sm\",\"style\":{\"borderRadius\":14},\"children\":[\"$\",\"div\",null,{\"className\":\"card-body p-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"fw-bold mb-3\",\"style\":{\"fontSize\":\"1.3rem\"},\"children\":\"How It Works\"}],[\"$\",\"div\",null,{\"className\":\"row g-4 text-center\",\"children\":[[\"$\",\"div\",\"1\",{\"className\":\"col-md-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-2\",\"style\":{\"width\":48,\"height\":48},\"children\":[\"$\",\"span\",null,{\"className\":\"fw-bold text-primary\",\"children\":\"1\"}]}],[\"$\",\"h6\",null,{\"className\":\"fw-semibold\",\"children\":\"Create a key\"}],[\"$\",\"p\",null,{\"className\":\"text-muted small\",\"children\":[\"Add tokens, then mint your \",[\"$\",\"code\",null,{\"children\":\"sk-rewind-\"}],\" key\"]}]]}],[\"$\",\"div\",\"2\",{\"className\":\"col-md-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-2\",\"style\":{\"width\":48,\"height\":48},\"children\":[\"$\",\"span\",null,{\"className\":\"fw-bold text-primary\",\"children\":\"2\"}]}],[\"$\",\"h6\",null,{\"className\":\"fw-semibold\",\"children\":\"Call Any Endpoint\"}],[\"$\",\"p\",null,{\"className\":\"text-muted small\",\"children\":\"One endpoint covers chat, images, TTS, STT, music and translation\"}]]}],[\"$\",\"div\",\"3\",{\"className\":\"col-md-4\",\"children\":[[\"$\",\"div\",null,{\"className\":\"rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-2\",\"style\":{\"width\":48,\"height\":48},\"children\":[\"$\",\"span\",null,{\"className\":\"fw-bold text-primary\",\"children\":\"3\"}]}],[\"$\",\"h6\",null,{\"className\":\"fw-semibold\",\"children\":\"Pay in Tokens\"}],[\"$\",\"p\",null,{\"className\":\"text-muted small\",\"children\":\"One balance, and every tool draws from it.\"}]]}]]}]]}]}]}]}],[\"$\",\"div\",null,{\"className\":\"row justify-content-center mb-5\",\"children\":[\"$\",\"div\",null,{\"className\":\"col-lg-10\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"fw-bold mb-3\",\"style\":{\"fontSize\":\"1.3rem\"},\"children\":\"Quick Start\"}],[\"$\",\"ul\",null,{\"className\":\"nav nav-tabs mb-3\",\"id\":\"codeTabs\",\"children\":[[\"$\",\"li\",null,{\"className\":\"nav-item\",\"children\":[\"$\",\"a\",null,{\"className\":\"nav-link active\",\"data-bs-toggle\":\"tab\",\"href\":\"#tab-curl\",\"children\":\"cURL\"}]}],[\"$\",\"li\",null,{\"className\":\"nav-item\",\"children\":[\"$\",\"a\",null,{\"className\":\"nav-link\",\"data-bs-toggle\":\"tab\",\"href\":\"#tab-python\",\"children\":\"Python\"}]}],[\"$\",\"li\",null,{\"className\":\"nav-item\",\"children\":[\"$\",\"a\",null,{\"className\":\"nav-link\",\"data-bs-toggle\":\"tab\",\"href\":\"#tab-node\",\"children\":\"Node.js\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"tab-content\",\"children\":[[\"$\",\"div\",null,{\"className\":\"tab-pane fade show active\",\"id\":\"tab-curl\",\"children\":[\"$\",\"pre\",null,{\"className\":\"p-3 rounded\",\"style\":{\"background\":\"#1e1e2e\",\"color\":\"#cdd6f4\",\"fontSize\":\".82rem\",\"overflowX\":\"auto\"},\"children\":[\"$\",\"code\",null,{\"children\":\"$8\"}]}]}],\"$L9\",\"$La\"]}]]}]}]]}]\n5:[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/0xbh.hlsqq2il.js\",\"asy